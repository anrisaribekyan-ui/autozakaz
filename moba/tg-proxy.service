[Unit]
Description=SOCKS-прокси до Telegram через VPS
After=network-online.target
Wants=network-online.target

[Service]
User=anri
Environment="AUTOSSH_GATETIME=0"
ExecStart=/usr/bin/autossh -M 0 -N -o "ServerAliveInterval 30" -o "ServerAliveCountMax 3" -o "ExitOnForwardFailure yes" -D 127.0.0.1:1080 root@217.179.49.241
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
